\ProvidesPackage{styles/rbruacademic}[2026/10/16 v2.0 RBRU Academic Textbook Style]

% 1. Page Geometry (Standard Royal 6x9 inch, Left Margin 1.5 in)
\RequirePackage{geometry}
\geometry{
    paperwidth=6in,
    paperheight=9in,
    top=1.0in,
    bottom=1.0in,
    inner=1.5in,
    outer=1.0in,
    headheight=32pt,
    footskip=0.45in,
    headsep=0.25in
}
\RequirePackage{enumitem}
\RequirePackage{amssymb}

% 2. Thai Fonts & Typography
\RequirePackage{fontspec}
\RequirePackage{xunicode}
\RequirePackage{xltxtra}
\defaultfontfeatures{Mapping=tex-text}

\setmainfont{TH Sarabun New}

\XeTeXlinebreaklocale "th_TH"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 3. Paragraph Indentation (1 Tab = 1.25 cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% 4. Color Palette (Modern Futuristic & AgriTech Tone)
\RequirePackage{xcolor}
\definecolor{rbruNavy}{HTML}{0D2B45}
\definecolor{rbruGold}{HTML}{D4AF37}
\definecolor{rbruSlate}{HTML}{203A43}
\definecolor{agriGreen}{HTML}{1B5E20}
\definecolor{agriLightGreen}{HTML}{E8F5E9}
\definecolor{agriDark}{HTML}{0F2027}
\definecolor{rbruCodeBg}{HTML}{F8F9FA}
\definecolor{rbruBorder}{HTML}{CFD8DC}
\definecolor{cyberCyan}{HTML}{00E5FF}
\definecolor{neonEmerald}{HTML}{00E676}
\definecolor{deepIndigo}{HTML}{0A192F}
\definecolor{techAmber}{HTML}{FFD600}
\definecolor{techAqua}{HTML}{00B4D8}
\definecolor{techViolet}{HTML}{7B2CBF}
\definecolor{softCyanBg}{HTML}{E0F7FA}
\definecolor{softYellowBg}{HTML}{FFFDE7}

% 5. Graphics, TikZ & Tables
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,shadows.blur,shadows,backgrounds}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{needspace}
\RequirePackage[section]{placeins}

\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=deepIndigo}, textfont={normalfont}, labelsep=thaisep, justification=raggedleft, singlelinecheck=false}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=deepIndigo}, textfont={normalfont}, labelsep=thaisep}

\renewcommand{\figurename}{\mbox{ภาพที่}}
\renewcommand{\tablename}{\mbox{ตารางที่}}

\AtBeginDocument{
    \gdef\figurename{\mbox{ภาพที่}}
    \gdef\tablename{\mbox{ตารางที่}}
    \captionsetup[figure]{name={\mbox{ภาพที่}}}
    \captionsetup[table]{name={\mbox{ตารางที่}}}
}

% 6. TColorBox Environments
\RequirePackage[many]{tcolorbox}

\newtcolorbox{planbox}[2][]{
    enhanced,
    breakable,
    colback=white,
    colframe=deepIndigo,
    fonttitle=\bfseries\fontsize{12}{15}\selectfont\color{white},
    coltitle=white,
    colbacktitle=deepIndigo,
    title={#2},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    titlerule=0pt,
    toptitle=3.5pt, bottomtitle=3.5pt,
    drop shadow=black!10,
    before skip=7pt,
    after skip=7pt,
    #1
}

\newtcolorbox{academicbox}[2][]{
    enhanced,
    breakable,
    colback=agriLightGreen!50!white,
    colframe=agriGreen,
    fonttitle=\bfseries\fontsize{12}{15}\selectfont\color{white},
    coltitle=white,
    colbacktitle=agriGreen,
    title={#2},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    before skip=7pt,
    after skip=7pt,
    #1
}

\newtcolorbox{nocodebox}[2][]{
    enhanced,
    breakable,
    colback=softCyanBg!35!white,
    colframe=techAqua!85!black,
    fonttitle=\bfseries\fontsize{12}{15}\selectfont\color{white},
    coltitle=white,
    colbacktitle=techAqua!85!black,
    title={#2},
    arc=2mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    drop shadow=techAqua!15,
    before skip=7pt,
    after skip=7pt,
    #1
}

% 7. Penalties
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% 8. Chapter and Section Formatting (Futuristic Modern Styling)
\RequirePackage{titlesec}

\newcommand{\rbruchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=2mm,
        boxrule=0pt,
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        interior style={left color=deepIndigo, right color=rbruSlate},
        borderline east={4pt}{0pt}{neonEmerald},
        borderline west={4pt}{0pt}{cyberCyan}
    ]
        \raggedleft
        {\fontsize{34}{40}\selectfont\bfseries\color{cyberCyan} \chaptertitlename\ \thechapter\par}
        \vspace{4pt}
        {\color{techAmber}\rule{0.60\textwidth}{2.2pt}\par}
        \vspace{6pt}
        {\fontsize{21}{27}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=2mm,
        boxrule=0pt,
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        interior style={left color=deepIndigo, right color=rbruSlate},
        borderline east={4pt}{0pt}{neonEmerald},
        borderline west={4pt}{0pt}{cyberCyan}
    ]
        \raggedleft
        {\fontsize{24}{30}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\rbruchapterbanner}
\titleformat{name=\chapter,numberless}[block]{\normalfont}{}{0pt}{\rbruunnumberedchapterbanner}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

\titleformat{\section}
  {\normalfont\fontsize{15.5}{19.5}\bfseries\color{deepIndigo}}
  {\makebox[1.25cm][l]{\color{techAqua}\rule[-1pt]{3.5pt}{13pt}\hspace{4pt}\thesection}}{0pt}{}
\titlespacing*{\section}{0pt}{14pt plus 2pt minus 2pt}{6pt plus 1pt minus 1pt}

\titleformat{\subsection}
  {\normalfont\fontsize{13.5}{17.5}\bfseries\color{agriGreen!90!black}}
  {\makebox[1.25cm][l]{\color{neonEmerald}\textbullet\hspace{4pt}\thesubsection}}{0pt}{}
\titlespacing*{\subsection}{1.25cm}{10pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\fontsize{9.5}{12}\selectfont\color{deepIndigo!85}\thepage\quad\textbullet\quad การออกแบบและพัฒนาแอปพลิเคชันสมาร์ทโฟนวิเคราะห์โรคในทุเรียน}
\fancyhead[RO]{\fontsize{9.5}{12}\selectfont\color{deepIndigo!85}\leftmark\quad\textbullet\quad\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\fontsize{9.5}{12}\selectfont\thepage}}

\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptertitlename\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}
