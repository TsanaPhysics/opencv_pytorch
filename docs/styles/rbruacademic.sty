% 7. Code Listings Environment
\RequirePackage{listings}
\lstset{
    backgroundcolor=\color{rbruCodeBg},
    basicstyle=\fontsize{8.5}{11}\selectfont\ttfamily,
    keywordstyle=\bfseries\color{codeKeyword},
    commentstyle=\itshape\color{codeComment},
    stringstyle=\color{codeString},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=7pt,
    showspaces=false,
    showstringspaces=false,
    tabsize=4,
    frame=single,
    rulecolor=\color{rbruBorder},
    breaklines=true,
    breakatwhitespace=true,
    captionpos=t,
    xleftmargin=1.5em,
    framexleftmargin=1.5em
}

% 8. Penalties to prevent widow/orphan lines
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% 9. Chapter and Section Formatting (Prominent Right-Aligned Banner)
\RequirePackage{titlesec}

\newcommand{\rbruchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=2.5mm,
        boxrule=0pt,
        top=18pt, bottom=18pt, left=18pt, right=18pt,
        interior style={left color=deepIndigo, right color=rbruSlate},
        borderline east={5pt}{0pt}{neonEmerald},
        borderline west={5pt}{0pt}{cyberCyan}
    ]
        \raggedleft
        {\fontsize{38}{46}\selectfont\bfseries\color{cyberCyan} \chaptertitlename\ \thechapter\par}
        \vspace{6pt}
        {\color{techAmber}\rule{0.65\textwidth}{2.5pt}\par}
        \vspace{8pt}
        {\fontsize{24}{30}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=2.5mm,
        boxrule=0pt,
        top=16pt, bottom=16pt, left=16pt, right=16pt,
        interior style={left color=deepIndigo, right color=rbruSlate},
        borderline north={2.5pt}{0pt}{techAmber},
        borderline south={2.5pt}{0pt}{techAmber}
    ]
        \centering
        {\fontsize{26}{32}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\rbruchapterbanner}
\titleformat{name=\chapter,numberless}[block]{\normalfont}{}{0pt}{\rbruunnumberedchapterbanner}
\titlespacing*{\chapter}{0pt}{-20pt}{18pt}

\titleformat{\section}
  {\normalfont\fontsize{18}{23}\bfseries\color{deepIndigo}}
  {\makebox[1.35cm][l]{\color{techAqua}\rule[-1pt]{4pt}{14pt}\hspace{5pt}\thesection}}{0pt}{}
\titlespacing*{\section}{0pt}{16pt plus 2pt minus 2pt}{8pt plus 1pt minus 1pt}

\titleformat{\subsection}
  {\normalfont\fontsize{16}{21}\bfseries\color{agriGreen!90!black}}
  {\makebox[1.35cm][l]{\color{neonEmerald}\textbullet\hspace{5pt}\thesubsection}}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt plus 2pt minus 2pt}{6pt plus 1pt minus 1pt}

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\fontsize{10.5}{13}\selectfont\color{deepIndigo!85}\thepage\quad\textbullet\quad การออกแบบและพัฒนาแอปพลิเคชันสมาร์ทโฟนวิเคราะห์โรคในทุเรียน}
\fancyhead[RO]{\fontsize{10.5}{13}\selectfont\color{deepIndigo!85}\leftmark\quad\textbullet\quad\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\fontsize{10.5}{13}\selectfont\thepage}}

\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptername\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}

% Index configuration
\makeindex
