\ProvidesPackage{styles/rbruacademic}[2026/10/16 v3.1 Thai Academic LaTeX Book Formatting - RBRU Masterclass A4 Profile]

% 1. Page Geometry (Official RBRU Standard: A4, Top 1.5in, Left 1.5in for Binding, Bottom 1.0in, Right 1.0in)
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
    left=1.5in,
    right=1.0in,
    headheight=36pt,
    footskip=0.50in,
    headsep=0.30in
}
\RequirePackage{enumitem}
\RequirePackage{amssymb}
\RequirePackage{amsmath}
\RequirePackage{makeidx}
\RequirePackage[hidelinks]{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=deepIndigo,
    citecolor=agriGreen,
    urlcolor=techAqua,
    bookmarksnumbered=true
}

% 2. Thai Fonts & Typography (Official RBRU Standard: 16pt Body Text, 1.15 line spacing)
\RequirePackage{scrextend}
\changefontsizes[22pt]{16pt}
\RequirePackage{fontspec}
\defaultfontfeatures{Mapping=tex-text}

\setmainfont{Sarabun}

\linespread{1.15}
\XeTeXlinebreaklocale "th_TH"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 3. Paragraph Indentation (Strictly 3em indent, no extra parskip as per profile)
\RequirePackage{indentfirst}
\setlength{\parindent}{3em}
\setlength{\parskip}{0pt}

% 4. Color Palette (Modern Futuristic & AgriTech Tone)
\RequirePackage{xcolor}
\definecolor{rbruNavy}{HTML}{0D2B45}
\definecolor{rbruGold}{HTML}{D4AF37}
\definecolor{rbruSlate}{HTML}{203A43}
\definecolor{agriGreen}{HTML}{1B5E20}
\definecolor{agriLightGreen}{HTML}{E8F5E9}
\definecolor{agriDark}{HTML}{0F2027}
\definecolor{rbruCodeBg}{HTML}{F8F9FA}
\definecolor{rbruBorder}{HTML}{CFD8DC}
\definecolor{cyberCyan}{HTML}{00E5FF}
\definecolor{neonEmerald}{HTML}{00E676}
\definecolor{deepIndigo}{HTML}{0A192F}
\definecolor{techAmber}{HTML}{FFD600}
\definecolor{techAqua}{HTML}{00B4D8}
\definecolor{techViolet}{HTML}{7B2CBF}
\definecolor{softCyanBg}{HTML}{E0F7FA}
\definecolor{softYellowBg}{HTML}{FFFDE7}
\definecolor{codeComment}{HTML}{6A737D}
\definecolor{codeKeyword}{HTML}{D73A49}
\definecolor{codeString}{HTML}{032F62}

% 5. Graphics, TikZ & Tables
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,shadows.blur,shadows,backgrounds}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{needspace}
\RequirePackage[section]{placeins}

% Captions formatting: Thai labels, separated by quad (no colon!), bold label, left-aligned with table
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{
    position=top,
    skip=7pt,
    labelfont={bf,color=deepIndigo},
    textfont={normalfont},
    labelsep=thaisep,
    justification=raggedright,
    singlelinecheck=false
}
\captionsetup[figure]{
    position=bottom,
    skip=8pt,
    labelfont={bf,color=deepIndigo},
    textfont={normalfont},
    labelsep=thaisep,
    justification=centering
}

% Table styling: Generous row height & padding, ragged-right columns to avoid word stretching
\renewcommand{\arraystretch}{1.28}
\setlength{\tabcolsep}{7pt}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

\renewcommand{\chaptername}{บทที่}
\renewcommand{\appendixname}{ภาคผนวก}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}
\renewcommand{\figurename}{\mbox{ภาพที่}}
\renewcommand{\tablename}{\mbox{ตารางที่}}

\AtBeginDocument{
    \renewcommand{\chaptername}{บทที่}
    \renewcommand{\appendixname}{ภาคผนวก}
    \renewcommand{\contentsname}{สารบัญ}
    \renewcommand{\listtablename}{สารบัญตาราง}
    \renewcommand{\listfigurename}{สารบัญภาพ}
    \renewcommand{\bibname}{บรรณานุกรม}
    \renewcommand{\indexname}{ดัชนีสืบค้นคำสำคัญ}
    \gdef\figurename{\mbox{ภาพที่}}
    \gdef\tablename{\mbox{ตารางที่}}
    \captionsetup[figure]{name={\mbox{ภาพที่}}}
    \captionsetup[table]{name={\mbox{ตารางที่}}}
}

