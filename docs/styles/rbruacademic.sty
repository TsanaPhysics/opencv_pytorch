\ProvidesPackage{styles/rbruacademic}[2026/10/16 v2.0 RBRU Academic Textbook Style]

% 1. Page Geometry (Standard Royal 6x9 inch, Left Margin 1.5 in)
\RequirePackage{geometry}
\geometry{
    paperwidth=6in,
    paperheight=9in,
    top=1.0in,
    bottom=1.0in,
    inner=1.5in,
    outer=1.0in,
    headheight=20pt,
    footskip=0.45in,
    headsep=0.35in
}
\RequirePackage{enumitem}

% 2. Thai Fonts & Typography
\RequirePackage{fontspec}
\RequirePackage{xunicode}
\RequirePackage{xltxtra}
\defaultfontfeatures{Mapping=tex-text}

\setmainfont{TH Sarabun New}

\XeTeXlinebreaklocale "th_TH"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% 3. Paragraph Indentation (1 Tab = 1.25 cm)
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% 4. Color Palette
\RequirePackage{xcolor}
\definecolor{rbruNavy}{HTML}{0D2B45}
\definecolor{rbruGold}{HTML}{D4AF37}
\definecolor{rbruSlate}{HTML}{203A43}
\definecolor{agriGreen}{HTML}{1B5E20}
\definecolor{agriLightGreen}{HTML}{E8F5E9}
\definecolor{agriDark}{HTML}{0F2027}
\definecolor{rbruCodeBg}{HTML}{F8F9FA}
\definecolor{rbruBorder}{HTML}{CFD8DC}

% 5. Graphics, TikZ & Tables
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,shadows.blur,backgrounds}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{needspace}
\RequirePackage[section]{placeins}

\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{position=top, skip=6pt, labelfont={bf,color=rbruNavy}, textfont={normalfont}, labelsep=thaisep, justification=raggedleft, singlelinecheck=false}
\captionsetup[figure]{position=bottom, skip=8pt, labelfont={bf,color=rbruNavy}, textfont={normalfont}, labelsep=thaisep}

\renewcommand{\figurename}{\mbox{ภาพที่}}
\renewcommand{\tablename}{\mbox{ตารางที่}}

\AtBeginDocument{
    \gdef\figurename{\mbox{ภาพที่}}
    \gdef\tablename{\mbox{ตารางที่}}
    \captionsetup[figure]{name={\mbox{ภาพที่}}}
    \captionsetup[table]{name={\mbox{ตารางที่}}}
}

% 6. TColorBox Environments
\RequirePackage[many]{tcolorbox}

\newtcolorbox{planbox}[2][]{
    enhanced,
    breakable,
    colback=white,
    colframe=rbruNavy,
    fonttitle=\bfseries\fontsize{12}{15}\selectfont\color{white},
    coltitle=white,
    colbacktitle=rbruNavy,
    title={#2},
    arc=1.5mm,
    boxrule=0.8pt,
    leftrule=3.5mm,
    top=4pt, bottom=4pt, left=8pt, right=8pt,
    titlerule=0pt,
    toptitle=3pt, bottomtitle=3pt,
    drop shadow=black!10,
    before skip=6pt,
    after skip=6pt,
    #1
}

\newtcolorbox{academicbox}[2][]{
    enhanced,
    breakable,
    colback=agriLightGreen!50!white,
    colframe=agriGreen,
    fonttitle=\bfseries\fontsize{12}{15}\selectfont\color{white},
    coltitle=white,
    colbacktitle=agriGreen,
    title={#2},
    arc=1.5mm,
    boxrule=0.8pt,
    leftrule=4mm,
    top=4pt, bottom=4pt, left=8pt, right=8pt,
    before skip=6pt,
    after skip=6pt,
    #1
}

% 7. Penalties
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% 8. Chapter and Section Formatting
\RequirePackage{titlesec}

\newcommand{\rbruchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=0mm,
        boxrule=0pt,
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        interior style={left color=rbruNavy!98!black, right color=rbruSlate},
        borderline east={4pt}{0pt}{rbruGold}
    ]
        \raggedleft
        {\fontsize{38}{44}\selectfont\bfseries\color{white} \chaptertitlename\ \thechapter\par}
        \vspace{4pt}
        {\color{rbruGold}\rule{0.55\textwidth}{2pt}\par}
        \vspace{6pt}
        {\fontsize{22}{28}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\newcommand{\rbruunnumberedchapterbanner}[1]{
    \begin{tcolorbox}[
        enhanced,
        width=\textwidth,
        arc=0mm,
        boxrule=0pt,
        top=14pt, bottom=14pt, left=14pt, right=14pt,
        interior style={left color=rbruNavy!98!black, right color=rbruSlate},
        borderline east={4pt}{0pt}{rbruGold}
    ]
        \raggedleft
        {\fontsize{26}{32}\selectfont\bfseries\color{white} #1\par}
    \end{tcolorbox}
}

\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\rbruchapterbanner}
\titleformat{name=\chapter,numberless}[block]{\normalfont}{}{0pt}{\rbruunnumberedchapterbanner}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

\titleformat{\section}
  {\normalfont\fontsize{16}{20}\bfseries\color{rbruNavy}}
  {\makebox[1.25cm][l]{\thesection}}{0pt}{}
\titlespacing*{\section}{0pt}{14pt plus 2pt minus 2pt}{6pt plus 1pt minus 1pt}

\titleformat{\subsection}
  {\normalfont\fontsize{14}{18}\bfseries\color{agriGreen}}
  {\makebox[1.25cm][l]{\thesubsection}}{0pt}{}
\titlespacing*{\subsection}{1.25cm}{10pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\fontsize{10}{12}\selectfont\color{rbruNavy!80}\thepage\quad\textbullet\quad ระบบคอมพิวเตอร์วิทัศน์วิเคราะห์โรคใบทุเรียน}
\fancyhead[RO]{\fontsize{10}{12}\selectfont\color{rbruNavy!80}\leftmark\quad\textbullet\quad\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\fontsize{10}{12}\selectfont\thepage}}

\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptertitlename\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}
